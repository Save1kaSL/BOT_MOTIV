# SQLite — файл базы, ничего ставить не надо
DATABASE_URL=file:./packages/db/prisma/bot.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=

# Обязательная подписка на канал (username без @)
REQUIRED_CHANNEL=working_moneymo

LOG_LEVEL=INFO
BOT_RATE_LIMIT_MAX=20

# Python bot (./bot.sh) — SQLite в python_bot/data/users.db
# ADMIN_TELEGRAM_IDS=123456789,987654321

# Фоновые задачи (reminders, retention): интервал в scheduler.py (по умолчанию 300 сек)

# Если Telegram заблокирован — прокси (опционально):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
